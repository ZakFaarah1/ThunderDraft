import type {
  Player,
  Position,
} from "../types";

export type MockDraftCpuStyle =
  | "balanced"
  | "adp-heavy"
  | "chaotic";

export interface CpuDraftCandidate {
  player: Player;
  score: number;
  reasons: string[];
}

export interface SelectCpuDraftPlayerOptions {
  availablePlayers: Player[];
  roster: Player[];
  overallPick: number;
  cpuStyle: MockDraftCpuStyle;
  teamCount?: number;
  random?: () => number;
}

interface CpuStyleSettings {
  adpWeight: number;
  rankingWeight: number;
  rosterWeight: number;
  randomRange: number;
  candidatePoolSize: number;
  selectionTemperature: number;
  earlyReachTolerance: number;
  middleReachTolerance: number;
  lateReachTolerance: number;
}

const ROSTER_LIMIT = 15;

const POSITION_LIMITS: Record<
  Position,
  number
> = {
  QB: 2,
  RB: 7,
  WR: 7,
  TE: 2,
  K: 1,
  DST: 1,
};

const STARTER_TARGETS: Record<
  Position,
  number
> = {
  QB: 1,
  RB: 2,
  WR: 2,
  TE: 1,
  K: 1,
  DST: 1,
};

const DEPTH_TARGETS: Record<
  Position,
  number
> = {
  QB: 1,
  RB: 5,
  WR: 5,
  TE: 2,
  K: 1,
  DST: 1,
};

function clamp(
  value: number,
  minimum: number,
  maximum: number,
): number {
  return Math.min(
    maximum,
    Math.max(minimum, value),
  );
}

function getCpuStyleSettings(
  cpuStyle: MockDraftCpuStyle,
): CpuStyleSettings {
  if (cpuStyle === "adp-heavy") {
    return {
      adpWeight: 1.55,
      rankingWeight: 0.85,
      rosterWeight: 1,
      randomRange: 5,
      candidatePoolSize: 6,
      selectionTemperature: 8,
      earlyReachTolerance: 8,
      middleReachTolerance: 12,
      lateReachTolerance: 18,
    };
  }

  if (cpuStyle === "chaotic") {
    return {
      adpWeight: 0.85,
      rankingWeight: 0.95,
      rosterWeight: 0.9,
      randomRange: 35,
      candidatePoolSize: 14,
      selectionTemperature: 30,
      earlyReachTolerance: 24,
      middleReachTolerance: 36,
      lateReachTolerance: 48,
    };
  }

  return {
    adpWeight: 1.1,
    rankingWeight: 1,
    rosterWeight: 1.1,
    randomRange: 14,
    candidatePoolSize: 9,
    selectionTemperature: 16,
    earlyReachTolerance: 14,
    middleReachTolerance: 20,
    lateReachTolerance: 30,
  };
}

function countRosterPositions(
  roster: Player[],
): Record<Position, number> {
  const counts: Record<
    Position,
    number
  > = {
    QB: 0,
    RB: 0,
    WR: 0,
    TE: 0,
    K: 0,
    DST: 0,
  };

  roster.forEach((player) => {
    counts[player.position] += 1;
  });

  return counts;
}

function isFlexPosition(
  position: Position,
): boolean {
  return (
    position === "RB" ||
    position === "WR" ||
    position === "TE"
  );
}

function getExpectedPick(
  player: Player,
): number {
  const hasAdp =
    player.adp !== null &&
    Number.isFinite(player.adp) &&
    player.adp > 0;

  const hasRank =
    Number.isFinite(player.overallRank) &&
    player.overallRank > 0;

  if (hasAdp && hasRank) {
    return (
      player.adp! * 0.65 +
      player.overallRank * 0.35
    );
  }

  if (hasAdp) {
    return player.adp!;
  }

  if (hasRank) {
    return player.overallRank;
  }

  return 250;
}

function getReachTolerance(
  settings: CpuStyleSettings,
  round: number,
): number {
  if (round <= 5) {
    return settings.earlyReachTolerance;
  }

  if (round <= 10) {
    return settings.middleReachTolerance;
  }

  return settings.lateReachTolerance;
}

function canDraftPosition(
  position: Position,
  counts: Record<Position, number>,
  round: number,
): boolean {
  if (
    counts[position] >=
    POSITION_LIMITS[position]
  ) {
    return false;
  }

  /*
   * Home-league drafts generally do not start
   * taking kickers and defenses in the early rounds.
   */
  if (
    (
      position === "K" ||
      position === "DST"
    ) &&
    round < 11
  ) {
    return false;
  }

  return true;
}

interface MissingRosterSlots {
  positions: Position[];
  flexSlots: number;
  total: number;
}

function getMissingRosterSlots(
  counts: Record<Position, number>,
): MissingRosterSlots {
  const positions: Position[] = [];

  (
    Object.keys(
      STARTER_TARGETS,
    ) as Position[]
  ).forEach((position) => {
    const missing =
      Math.max(
        0,
        STARTER_TARGETS[position] -
          counts[position],
      );

    for (
      let index = 0;
      index < missing;
      index += 1
    ) {
      positions.push(position);
    }
  });

  const skillPlayerCount =
    counts.RB +
    counts.WR +
    counts.TE;

  /*
   * RB2 + WR2 + TE1 + FLEX requires
   * six combined RB/WR/TE players.
   */
  const flexSlots =
    Math.max(
      0,
      6 - skillPlayerCount -
        positions.filter(
          (position) =>
            isFlexPosition(position),
        ).length,
    );

  return {
    positions,
    flexSlots,
    total:
      positions.length +
      flexSlots,
  };
}

function candidateFillsMissingSlot(
  player: Player,
  missing: MissingRosterSlots,
): boolean {
  if (
    missing.positions.includes(
      player.position,
    )
  ) {
    return true;
  }

  return (
    missing.flexSlots > 0 &&
    isFlexPosition(player.position)
  );
}

function getRankingScore(
  player: Player,
  overallPick: number,
): number {
  const rankGap =
    overallPick -
    player.overallRank;

  const rankScore =
    clamp(
      72 + rankGap * 1.8,
      -70,
      145,
    );

  const tierScore =
    clamp(
      34 -
        Math.max(
          player.tier - 1,
          0,
        ) *
          7,
      0,
      34,
    );

  const positionRankScore =
    clamp(
      20 -
        Math.max(
          player.positionRank - 1,
          0,
        ) *
          0.55,
      0,
      20,
    );

  return (
    rankScore +
    tierScore +
    positionRankScore
  );
}

function getAdpScore(
  player: Player,
  overallPick: number,
): number {
  if (
    player.adp === null ||
    !Number.isFinite(player.adp)
  ) {
    return 0;
  }

  const valueDifference =
    overallPick -
    player.adp;

  /*
   * Reaching 5-10 spots is normal.
   * Reaching 30-50 spots gets progressively painful.
   */
  return clamp(
    62 +
      valueDifference * 2.5,
    -110,
    145,
  );
}

function getRosterNeedScore(
  player: Player,
  counts: Record<Position, number>,
  round: number,
): {
  score: number;
  reasons: string[];
} {
  const reasons: string[] = [];

  const currentCount =
    counts[player.position];

  const starterTarget =
    STARTER_TARGETS[player.position];

  const depthTarget =
    DEPTH_TARGETS[player.position];

  let score = 0;

  if (currentCount < starterTarget) {
    if (
      player.position === "RB" ||
      player.position === "WR"
    ) {
      score += 58;
    } else if (
      player.position === "QB" ||
      player.position === "TE"
    ) {
      score += 34;
    } else {
      score +=
        round >= 13
          ? 55
          : 8;
    }

    reasons.push(
      `Fills an open ${player.position} starter`,
    );
  } else if (
    player.position === "RB" ||
    player.position === "WR"
  ) {
    if (currentCount < depthTarget) {
      score += 22;

      reasons.push(
        "Adds useful RB/WR depth",
      );
    } else {
      score -= 18;
    }
  } else if (
    player.position === "QB"
  ) {
    if (currentCount >= 1) {
      score +=
        round >= 11
          ? -20
          : -90;

      reasons.push(
        "Backup quarterback luxury",
      );
    }
  } else if (
    player.position === "TE"
  ) {
    if (currentCount >= 1) {
      score +=
        round >= 9
          ? -12
          : -65;

      reasons.push(
        "Secondary tight end",
      );
    }
  }

  return {
    score,
    reasons,
  };
}

function getRoundStrategyScore(
  player: Player,
  counts: Record<Position, number>,
  round: number,
): number {
  let score = 0;

  if (
    player.position === "RB" ||
    player.position === "WR"
  ) {
    if (round <= 8) {
      score += 18;
    }
  }

  if (player.position === "QB") {
    if (
      counts.QB === 0 &&
      round >= 6
    ) {
      score += 24;
    }

    if (
      counts.QB === 0 &&
      player.tier <= 2 &&
      round <= 5
    ) {
      score += 22;
    }

    if (
      counts.QB >= 1 &&
      round <= 9
    ) {
      score -= 35;
    }
  }

  if (player.position === "TE") {
    if (
      counts.TE === 0 &&
      player.tier <= 2 &&
      round <= 5
    ) {
      score += 24;
    }

    if (
      counts.TE >= 1 &&
      round <= 8
    ) {
      score -= 30;
    }
  }

  if (
    player.position === "K" ||
    player.position === "DST"
  ) {
    if (round <= 12) {
      score -= 45;
    } else {
      score += 22;
    }
  }

  return score;
}

function getRosterCompletionScore(
  player: Player,
  roster: Player[],
  counts: Record<Position, number>,
): number {
  const missing =
    getMissingRosterSlots(
      counts,
    );

  if (missing.total === 0) {
    return 0;
  }

  if (
    !candidateFillsMissingSlot(
      player,
      missing,
    )
  ) {
    return 0;
  }

  const remainingSlots =
    ROSTER_LIMIT -
    roster.length;

  if (
    remainingSlots <=
    missing.total
  ) {
    return 320;
  }

  if (
    remainingSlots ===
    missing.total + 1
  ) {
    return 180;
  }

  if (
    remainingSlots ===
    missing.total + 2
  ) {
    return 90;
  }

  return 25;
}

function getRandomAdjustment(
  random: () => number,
  range: number,
): number {
  return (
    (random() * 2 - 1) *
    range
  );
}

export function rankCpuDraftCandidates(
  options: SelectCpuDraftPlayerOptions,
): CpuDraftCandidate[] {
  const {
    availablePlayers,
    roster,
    overallPick,
    cpuStyle,
    teamCount = 12,
    random = Math.random,
  } = options;

  if (
    roster.length >=
    ROSTER_LIMIT
  ) {
    return [];
  }

  const round =
    Math.floor(
      (overallPick - 1) /
        teamCount,
    ) + 1;

  const counts =
    countRosterPositions(
      roster,
    );

  const settings =
    getCpuStyleSettings(
      cpuStyle,
    );

  const missing =
    getMissingRosterSlots(
      counts,
    );

  const remainingSlots =
    ROSTER_LIMIT -
    roster.length;

  const mustFillStarterNow =
    missing.total > 0 &&
    remainingSlots <=
      missing.total;

  let legalPlayers =
    availablePlayers.filter(
      (player) =>
        canDraftPosition(
          player.position,
          counts,
          round,
        ),
    );

  /*
   * If there are exactly enough picks left to complete
   * the starting lineup, the CPU cannot spend one on
   * a luxury bench selection.
   */
  if (mustFillStarterNow) {
    legalPlayers =
      legalPlayers.filter(
        (player) =>
          candidateFillsMissingSlot(
            player,
            missing,
          ),
      );
  }

  if (legalPlayers.length === 0) {
    return [];
  }

  const reachTolerance =
    getReachTolerance(
      settings,
      round,
    );

  const marketWindow =
    legalPlayers.filter(
      (player) =>
        getExpectedPick(player) <=
        overallPick +
          reachTolerance,
    );

  /*
   * We normally draft from a realistic market window.
   * If it becomes too small, fall back only to the
   * best market options rather than the entire pool.
   */
  const candidateSource =
    marketWindow.length >= 4 ||
    marketWindow.length ===
      legalPlayers.length
      ? marketWindow
      : [...legalPlayers]
          .sort(
            (
              first,
              second,
            ) =>
              getExpectedPick(first) -
              getExpectedPick(second),
          )
          .slice(
            0,
            Math.max(
              8,
              settings.candidatePoolSize *
                2,
            ),
          );

  return candidateSource
    .map(
      (
        player,
      ): CpuDraftCandidate => {
        const reasons: string[] = [];

        const rankingScore =
          getRankingScore(
            player,
            overallPick,
          ) *
          settings.rankingWeight;

        const adpScore =
          getAdpScore(
            player,
            overallPick,
          ) *
          settings.adpWeight;

        const rosterNeed =
          getRosterNeedScore(
            player,
            counts,
            round,
          );

        reasons.push(
          ...rosterNeed.reasons,
        );

        const rosterScore =
          rosterNeed.score *
          settings.rosterWeight;

        const roundScore =
          getRoundStrategyScore(
            player,
            counts,
            round,
          );

        const completionScore =
          getRosterCompletionScore(
            player,
            roster,
            counts,
          );

        /*
         * Raw fantasy projections are not directly
         * comparable across positions, so they only
         * provide a small tiebreaking influence.
         */
        const projectionScore =
          player.projectedPoints ===
          null
            ? 0
            : Math.min(
                player.projectedPoints /
                  30,
                10,
              );

        const randomAdjustment =
          getRandomAdjustment(
            random,
            settings.randomRange,
          );

        const score =
          rankingScore +
          adpScore +
          rosterScore +
          roundScore +
          completionScore +
          projectionScore +
          randomAdjustment;

        if (
          player.adp !== null &&
          player.adp <
            overallPick
        ) {
          reasons.push(
            "Fell past market ADP",
          );
        }

        if (
          player.tier === 1
        ) {
          reasons.push(
            "Elite Tier 1 player",
          );
        }

        if (
          completionScore >=
          180
        ) {
          reasons.push(
            "Needed to complete a legal lineup",
          );
        }

        return {
          player,
          score,
          reasons,
        };
      },
    )
    .sort(
      (
        first,
        second,
      ) =>
        second.score -
        first.score,
    );
}

export function selectCpuDraftPlayer(
  options: SelectCpuDraftPlayerOptions,
): Player | null {
  const random =
    options.random ??
    Math.random;

  const settings =
    getCpuStyleSettings(
      options.cpuStyle,
    );

  const candidates =
    rankCpuDraftCandidates({
      ...options,
      random,
    }).slice(
      0,
      settings.candidatePoolSize,
    );

  if (
    candidates.length === 0
  ) {
    return null;
  }

  const highestScore =
    candidates[0].score;

  const weights =
    candidates.map(
      (candidate) =>
        Math.exp(
          (
            candidate.score -
            highestScore
          ) /
            settings.selectionTemperature,
        ),
    );

  const totalWeight =
    weights.reduce(
      (
        total,
        weight,
      ) =>
        total + weight,
      0,
    );

  let selectionPoint =
    random() *
    totalWeight;

  for (
    let index = 0;
    index <
    candidates.length;
    index += 1
  ) {
    selectionPoint -=
      weights[index];

    if (
      selectionPoint <= 0
    ) {
      return candidates[index]
        .player;
    }
  }

  return candidates[
    candidates.length - 1
  ].player;
}

export function createSeededRandom(
  seed: number,
): () => number {
  let state =
    seed >>> 0;

  return () => {
    state +=
      0x6d2b79f5;

    let result = state;

    result = Math.imul(
      result ^
        (result >>> 15),
      result | 1,
    );

    result ^=
      result +
      Math.imul(
        result ^
          (result >>> 7),
        result | 61,
      );

    return (
      (
        (
          result ^
          (result >>> 14)
        ) >>>
        0
      ) /
      4294967296
    );
  };
}

export function createMockDraftSeed(): number {
  return Math.floor(
    Math.random() *
      2147483647,
  );
}
